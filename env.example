# Copy to .env. Leave LLM_API_KEY unset to run on the built-in template plan.
LLM_API_KEY=
# Any OpenAI-compatible endpoint. Omit for OpenAI itself.
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Reasoning models (gpt-oss, o-series) need a large token budget; "low" effort keeps replies fast.
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=6000
LOG_LEVEL=INFO
